  "transcript": [
    { "t": 0.0,  "text": "Let's look at a function.",                                                       "speaker": "S1" },
    { "t": 2.5,  "text": "f of x equals x squared minus one, divided by x minus one.",                      "speaker": "S1" },
    { "t": 8.0,  "text": "Now what's f of two?",                                                             "speaker": "S1" },
    { "t": 10.5, "text": "Well, two squared is four, minus one is three, over two minus one is one.",       "speaker": "S1" },
    { "t": 16.0, "text": "So f of two equals three.",                                                        "speaker": "S1" },
    { "t": 18.5, "text": "But what about f of one?",                                                         "speaker": "S1" },
    { "t": 21.0, "text": "One squared is one, minus one is zero, over one minus one is also zero.",         "speaker": "S1" },
    { "t": 27.0, "text": "Zero over zero. Undefined.",                                                       "speaker": "S1" }
  ],
  "symbols": [
    {
      "t": 2.5,
      "kind": "latex",
      "data": "f(x) = \\frac{x^2 - 1}{x - 1}",
      "bbox": [0.2, 0.25, 0.6, 0.15],
      "duration_s": 5.5
    },
    {
      "t": 10.5,
      "kind": "latex",
      "data": "f(2) = \\frac{2^2 - 1}{2 - 1} = \\frac{3}{1} = 3",
      "bbox": [0.2, 0.45, 0.6, 0.15],
      "duration_s": 7.0
    },
    {
      "t": 21.0,
      "kind": "latex",
      "data": "f(1) = \\frac{1^2 - 1}{1 - 1} = \\frac{0}{0}",
      "bbox": [0.2, 0.65, 0.6, 0.15],
      "duration_s": 9.0
    }
  ],
  "scenes": [
    { "t": 0, "layout": "whiteboard", "background": "white" }
  ],
  "accessibility": {
    "math_speech": [
      { "t": 2.5,  "text": "f of x equals the quantity x squared minus one, all divided by x minus one." },
      { "t": 10.5, "text": "f of two equals the quantity two squared minus one, all over two minus one, which equals three over one, which equals three." },
      { "t": 21.0, "text": "f of one equals the quantity one squared minus one, all over one minus one, which equals zero over zero." }
    ],
    "alt_text": [
      { "t": 0, "text": "A whiteboard showing an algebra example: the function f of x equals x squared minus one over x minus one, evaluated at x equals two and x equals one." }
    ]
