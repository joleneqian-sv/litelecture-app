  "accessibility": {
    "math_speech": [
      {
        "t": 26.0,
        "text": "f of x equals the quantity x minus one, over x minus one."
      },
      {
        "t": 60.0,
        "text": "f of one equals zero over zero, which is undefined."
      },
      {
        "t": 87.0,
        "text": "f of x equals one, for x not equal to one."
      },
      {
        "t": 0.0,
        "text": "The limit of f of x as x approaches c."
      },
      {
        "t": 201.0,
        "text": "f of one is undefined."
      },
      {
        "t": 213.0,
        "text": "What is the limit of f of x as x approaches one?"
      },
      {
        "t": 246.0,
        "text": "The limit of f of x as x approaches one."
      },
      {
        "t": 275.0,
        "text": "The limit of f of x as x approaches one equals one."
      },
      {
        "t": 297.0,
        "text": "g of x equals x squared when x is not equal to two, and equals one when x equals two."
      },
      {
        "t": 431.0,
        "text": "g of two equals one."
      },
      {
        "t": 501.0,
        "text": "The limit of g of x as x approaches two."
      },
      {
        "t": 527.0,
        "text": "As x approaches two from below: one point nine, one point nine nine, one point nine nine nine. From above: two point one, two point zero one, two point zero zero one."
      },
      {
        "t": 558.0,
        "text": "The limit of g of x as x approaches two equals four."
      },
      {
        "t": 593.0,
        "text": "One point nine squared equals three point six one."
      },
      {
        "t": 607.0,
        "text": "One point nine nine squared equals three point nine six zero one."
      },
      {
        "t": 614.0,
        "text": "One point nine nine nine squared is approximately three point nine nine six."
      },
      {
        "t": 654.0,
        "text": "Two point one squared equals four point four one."
      },
      {
        "t": 662.0,
        "text": "Two point zero one squared equals four point zero four zero one."
      },
      {
        "t": 673.0,
        "text": "The limit of g of x as x approaches two equals four."
      }
    ]
  },
